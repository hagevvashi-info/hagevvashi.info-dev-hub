{
  "permissions": {
    "allow": [
      "mcp__atlassian__getConfluencePage"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/${MDC_REPO_ROOT}/.claude/hooks/check-deprecated-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "agent",
            "prompt": "ユーザーがファイルを修正しました。review エージェントを起動して、修正内容をレビューしてください。"
          }
        ]
      }
    ]
  }
}
