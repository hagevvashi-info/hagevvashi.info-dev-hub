{
  "permissions": {
    "allow": [
      "mcp__atlassian__getConfluencePage"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GIT_EXPERT_OPERATION=1 ${HOME}/${MDC_REPO_ROOT}/.claude/hooks/check-deprecated-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/${MDC_REPO_ROOT}/.claude/hooks/orchestrate_review.sh\""
          }
        ]
      }
    ]
  }
}
