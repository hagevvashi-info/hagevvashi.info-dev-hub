{
  "folders": [
    {
      "path": "."
    },
    // 以下、repos/ 配下のプロダクトリポジトリを追加
    // 例:
    // {
    //   "path": "repos/product-a",
    //   "name": "product-a"
    // },
    // {
    //   "path": "repos/product-b",
    //   "name": "product-b"
    // }
  ],
  "settings": {
    "files.exclude": {
      ".DS_Store": true,
      "**/.DS_Store": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.git": true,
      "**/.vscode": true
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "files.trimTrailingWhitespace": false
    },
    "git.autofetch": true,
    "git.detectSubmodules": true,
    "explorer.excludeGitIgnore": false,
    "editor.rulers": [80, 120],
    "editor.semanticHighlighting.enabled": true,
    "terminal.integrated.minimumContrastRatio": 1,
    "files.autoSave": "afterDelay",
    "editor.tabSize": 2,
    "specstory.autoSave.enabled": true,
    "specstory.helpUsImprove": false,
    "specstory.coordinatedUniversalTimezone": false,
    "search.followSymlinks": false,
    "specstory.cloudSync.enabled": "never"
  },
  "extensions": {
    "recommendations": [
      "anysphere.remote-containers",
      "SpecStory.specstory-vscode",
      "EditorConfig.EditorConfig",
      "4ops.terraform",
      "GitHub.vscode-pull-request-github",
      "Anthropic.claude-code",
      "google.gemini-cli-vscode-ide-companion",
      "Google.geminicodeassist",
      "bierner.markdown-mermaid",
      "ms-python.python",
      "antfu.browse-lite",
      "ms-vscode-remote.remote-containers",
      "openai.chatgpt"
    ]
  }
}
